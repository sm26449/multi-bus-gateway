{
 "device_template": {
  "schema_version": 1,
  "id": "seplos_bms_mqtt",
  "name": "Seplos BMS V3 (via seplos-bms-mqtt)",
  "vendor": "Seplos",
  "model": "BMS V3",
  "version": "1.0",
  "author": "Multi-Bus Gateway",
  "description": "One battery pack of the seplos-bms-mqtt collector (https://github.com/sm2669/seplos-bms-mqtt): the collector passively snoops the RS485 pack bus and publishes seplos/battery_N/<field>; this template ingests the full field set over MQTT. Set the device input topic to seplos/battery_N/# — register topics are RELATIVE (~/).",
  "protocol": {
   "transports": [
    "mqtt"
   ]
  },
  "categories": {
   "battery": {
    "label": "Battery",
    "order": 1
   },
