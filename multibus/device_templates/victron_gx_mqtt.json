     },
     {
      "name": "time_to_go_h",
      "label": "Time to go",
      "unit": "h",
      "decimals": 1,
      "expr": "time_to_go / 3600",
      "category": "battery"
     },
     {
      "name": "battery_status",
      "label": "Battery state",
      "category": "battery",
      "expr": "1 if battery_power > 20 else 2 if battery_power < -20 else 0",
      "enum": {
       "0": "Idle",
       "1": "Charging",
       "2": "Discharging"
      }
     }
    ]
