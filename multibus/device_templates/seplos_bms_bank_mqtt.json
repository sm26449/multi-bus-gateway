        "address": 5,
        "name": "status",
        "label": "Status",
        "unit": "",
        "data_type": "uint16",
        "category": "battery",
        "topic": "~/pack_status",
        "poll_group": "normal",
        "defaults": {
          "mqtt": {
            "enabled": false
          },
          "influxdb": {
            "enabled": false
          },
          "ui": {
            "show_on_dashboard": true,
            "widget": "value"
          }
        },
        "enum": {
          "0": "Standby",
          "1": "Charging",
          "2": "Discharging",
          "3": "Float Charging",
          "4": "Unknown"
        }
