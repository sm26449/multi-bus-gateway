{
  "device_template": {
    "schema_version": 1,
    "id": "seplos_bms_bank_mqtt",
    "name": "Seplos BMS V3 bank (via seplos-bms-mqtt)",
    "vendor": "Seplos",
    "model": "BMS V3 bank",
    "version": "1.0",
    "author": "Multi-Bus Gateway",
    "description": "The whole battery BANK as one device: the seplos-bms-mqtt collector aggregates its packs under seplos/pack/pack_* (sums, averages, min/max, worst-cell). Set the device input topic to seplos/pack/# — register topics are relative. Pairs with seplos_bms_mqtt for per-pack detail.",
    "protocol": {
      "transports": [
        "mqtt"
      ]
    },
    "categories": {
      "battery": {
        "label": "Battery",
        "order": 1
      },
      "cells": {
        "label": "Cells",
        "order": 2
      },
      "temperature": {
        "label": "Temperature",
        "order": 3
      },
      "limits": {
        "label": "Limits",
        "order": 4
      },
      "alarms": {
        "label": "Alarms",
        "order": 5
      },
      "diagnostics": {
        "label": "Diagnostics",
        "order": 6
      }
    },
    "registers": [
      {
        "address": 1,
        "name": "average_soc",
        "label": "State of charge (avg)",
        "unit": "%",
        "data_type": "float",
        "category": "battery",
        "topic": "~/pack_average_soc",
        "poll_group": "normal",
        "defaults": {
          "mqtt": {
            "enabled": false
          },
          "influxdb": {
            "enabled": false
          },
          "ui": {
            "show_on_dashboard": true,
            "widget": "gauge"
          }
        }
      },
      {
        "address": 2,
        "name": "total_power",
        "label": "Total power",
        "unit": "W",
        "data_type": "float",
        "category": "battery",
        "topic": "~/pack_total_power",
        "poll_group": "normal",
        "defaults": {
          "mqtt": {
            "enabled": false
          },
          "influxdb": {
            "enabled": false
          },
          "ui": {
            "show_on_dashboard": true,
            "widget": "chart"
          }
        }
      },
      {
        "address": 3,
        "name": "total_voltage",
        "label": "Bank voltage (avg)",
        "unit": "V",
        "data_type": "float",
        "category": "battery",
        "topic": "~/pack_total_voltage",
        "poll_group": "normal",
