        "address": 40087,
        "name": "power_active_total",
        "label": "Total active power",
        "unit": "W",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.PowerReal_P_Sum",
        "description": "Positive = importing from the grid, negative = exporting (checked against the datalogger's own P_Grid).",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
