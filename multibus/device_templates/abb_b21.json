    "category": "frequency",
    "poll_group": "realtime",
    "description": "Grid frequency"
   },
   {
    "address": 23354,
    "name": "power_factor_total",
    "label": "Power factor",
    "unit": "",
    "data_type": "int16",
    "scale": 1000,
    "register_type": "holding",
