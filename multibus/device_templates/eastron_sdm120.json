    "category": "energy_active",
    "poll_group": "slow",
    "description": "Total exported active energy"
   },
   {
    "address": 342,
    "name": "energy_active_total",
    "label": "Total active energy",
    "unit": "kWh",
    "data_type": "float",
    "register_type": "input",
    "category": "energy_active",
    "poll_group": "slow",
