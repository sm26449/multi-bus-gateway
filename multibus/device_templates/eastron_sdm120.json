{
 "device_template": {
  "schema_version": 1,
  "id": "eastron_sdm120",
  "name": "Eastron SDM120 (single-phase)",
  "vendor": "Eastron",
  "model": "SDM120 Modbus",
  "version": "0.9.0",
  "description": "Eastron SDM120 single-phase energy meter (also SDM220). Measurements are 32-bit IEEE-754 floats in INPUT registers (FC4), big-endian — same base addresses as the SDM630 phase 1. Community-sourced canonical map — verify against your unit's manual.",
  "source_document": "Eastron SDM120/SDM220 Modbus Protocol (input registers, FC04, float32)",
  "protocol": {
   "byte_order": "big",
   "default_register_type": "input"
  },
  "categories": {},
  "registers": [
   {
    "address": 0,
    "name": "voltage_l1_n",
    "label": "Voltage",
    "unit": "V",
    "data_type": "float",
    "register_type": "input",
    "category": "voltage",
    "poll_group": "realtime",
    "description": "L1–N RMS voltage"
   },
   {
    "address": 6,
    "name": "current_l1",
    "label": "Current",
    "unit": "A",
    "data_type": "float",
    "register_type": "input",
    "category": "current",
    "poll_group": "realtime",
    "description": "L1 current"
   },
   {
    "address": 12,
    "name": "power_active_total",
    "label": "Active power",
    "unit": "W",
    "data_type": "float",
    "register_type": "input",
    "category": "power_active",
    "poll_group": "realtime",
    "description": "Total active power"
   },
   {
    "address": 18,
    "name": "power_apparent_total",
    "label": "Apparent power",
    "unit": "VA",
    "data_type": "float",
    "register_type": "input",
    "category": "power_apparent",
    "poll_group": "normal",
    "description": "Total apparent power"
   },
   {
    "address": 24,
    "name": "power_reactive_total",
    "label": "Reactive power",
    "unit": "var",
    "data_type": "float",
    "register_type": "input",
    "category": "power_reactive",
    "poll_group": "normal",
    "description": "Total reactive power"
   },
   {
    "address": 30,
    "name": "power_factor_total",
    "label": "Power factor",
    "unit": "",
    "data_type": "float",
    "register_type": "input",
    "category": "power_factor",
    "poll_group": "normal",
    "description": "System power factor"
   },
   {
    "address": 70,
    "name": "frequency",
    "label": "Frequency",
    "unit": "Hz",
    "data_type": "float",
