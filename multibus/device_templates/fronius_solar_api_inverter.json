{
  "device_template": {
    "id": "fronius_solar_api_inverter",
    "name": "Fronius inverter (Solar API / HTTP-JSON)",
    "manufacturer": "Fronius",
    "description": "ONE HTTP request per inverter to the DataManager's Solar API (GetInverterRealtimeData.cgi?Scope=Device&DeviceId=${unit_id}&DataCollection=CommonInverterData).\n\nMeasured on a production DataManager 2026-09-12: 54 ms median per call (25 calls, worst 197 ms) against 1945-2376 ms for a single Modbus read of the same box, and those calls over live Modbus polling caused zero overruns and left Modbus latency unchanged - the web server answers from the cache it fills off its own RS-485 side. That cache refreshes about every 2.6 s, so polling faster than 5 s buys nothing real.\n\nThis collection carries ONE ac voltage and ONE ac current, not per phase: the per-phase values live in a different collection (3PInverterData) and would cost a second request. They stay on Modbus, together with the four things the Solar API cannot give at all - power factor, reactive and apparent power, the SunSpec event flags, and the per-string MPPT block.",
    "protocol": {
      "transports": [
        "http"
      ],
      "byte_order": "big"
    },
    "poll_groups": {
      "realtime": {
        "interval": 5,
        "description": "power, frequency, U/I, DC"
      },
      "normal": {
        "interval": 30,
        "description": "energy counter"
      }
    },
    "registers": [
      {
        "address": 1,
        "name": "power_active_total",
        "label": "Total active power",
        "unit": "W",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.PAC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 2,
        "name": "frequency",
        "label": "Frequency",
        "unit": "Hz",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.FAC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 3,
        "name": "voltage_ln_avg",
        "label": "AC voltage",
        "unit": "V",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.UAC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 4,
        "name": "current_total",
        "label": "Total AC current",
        "unit": "A",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.IAC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 5,
        "name": "voltage_dc",
        "label": "DC voltage",
        "unit": "V",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.UDC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 6,
        "name": "current_dc",
        "label": "DC current",
        "unit": "A",
        "data_type": "float",
        "access": "RD",
        "poll_group": "realtime",
        "json_path": "Body.Data.IDC.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      },
      {
        "address": 7,
        "name": "energy_active_generated",
        "label": "Total energy generated",
        "unit": "Wh",
        "data_type": "float",
        "access": "RD",
        "poll_group": "normal",
        "json_path": "Body.Data.TOTAL_ENERGY.Value",
        "defaults": {
          "mqtt": {
            "enabled": true
          },
          "influxdb": {
            "enabled": true
          }
        }
      }
    ]
  }
}
