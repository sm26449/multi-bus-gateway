    "calculated": [
      {
        "name": "status_text",
        "label": "Operating state",
        "expr": "operating_state",
        "poll_group": "normal",
        "topic": "status/text",
        "influxdb": false,
        "enum": {
          "1": "Off",
          "2": "Sleeping (auto-shutdown)",
          "3": "Starting up",
          "4": "Tracking power point",
          "5": "Forced power reduction",
          "6": "Shutting down",
          "7": "One or more faults exist",
          "8": "Standby",
          "9": "No SolarNet communication",
          "10": "No communication with inverter",
          "11": "Overcurrent on SolarNet plug",
          "12": "Inverter is being updated",
          "13": "AFCI Event"
        }
      },
      {
        "name": "status_alarm",
        "label": "Alarm",
        "expr": "1 if (operating_state == 5 or operating_state == 7 or operating_state == 9 or operating_state == 10 or operating_state == 11 or operating_state == 13) else 0",
        "poll_group": "normal",
        "topic": "status/alarm",
        "measurement": "status"
      },
      {
        "name": "status_active",
        "label": "Actively producing",
        "expr": "1 if (operating_state == 4 or operating_state == 5) else 0",
        "poll_group": "normal",
        "topic": "status/active",
        "measurement": "status"
      }
    ]
  }
