# Minimal image for the load-test simulators (S1 device fleet / S3 swarm).
FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir "pymodbus==3.15.0"
# context is the loadtest/ dir itself (the root .dockerignore excludes
# loadtest/ from the MAIN image context — a separate context sidesteps it)
COPY . ./loadtest/
