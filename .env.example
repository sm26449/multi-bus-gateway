# Multi-Bus Gateway - Environment Configuration
# Copy this file to .env and modify as needed
#
# Modbus / MQTT / InfluxDB are normally configured from the UI (Config -> Settings),
# persisted to config/config.yaml and applied without a restart — you do NOT need to
# set them here. The variables below are OPTIONAL: uncomment them only to pre-seed a
# fresh deploy. A value set here OVERRIDES the UI/config.yaml on every restart, and the
# UI shows that field as "locked by environment". (Also uncomment the matching lines in
# docker-compose.yml.) Variable names are UNPREFIXED (MODBUS_HOST, not JANITZA_MODBUS_HOST).

# ======================
# Modbus Configuration (optional — usually set from the UI)
# ======================
# MODBUS_HOST=192.168.1.100
# MODBUS_PORT=502
# MODBUS_UNIT_ID=1
# Seconds without a successful read before the primary source is flagged stale.
# MODBUS_STALE_AFTER_S=30

# ======================
# MQTT (the stack bundles its own broker — `mosquitto` — and the gateway
# points at it by default; nothing to set here for the bundled stack.
# Uncomment only to pre-seed an EXTERNAL broker.)
# ======================
# MQTT_ENABLED=true
# MQTT_BROKER=my-external-broker
# MQTT_PORT=1883
# REQUIRED since 3.81.0: the bundled broker refuses anonymous clients and
# `docker compose up` refuses to start without these. The gateway and every
# other consumer on the LAN (Home Assistant, Node-RED, Telegraf…) log in with
# this pair; when you bring your own broker, put ITS credentials here.
MQTT_USERNAME=mbg
MQTT_PASSWORD=change-me-to-a-long-random-secret
# MQTT_PREFIX=multibus/umg512
# MQTT_PUBLISH_MODE=changed
# Bundled-broker host ports (change on conflict):
# MQTT_BROKER_PORT=1883
# MQTT_WS_PORT=9001
# MQTT_EXPLORER_PORT=4000    # only with `--profile debug`; bound to 127.0.0.1
# STACK_BIND=0.0.0.0         # 127.0.0.1 keeps broker/InfluxDB/Grafana host-local
# Bundled InfluxDB/Grafana host ports (change when the host already runs one):
# INFLUXDB_HOST_PORT=8086
# GRAFANA_HOST_PORT=3000
# Host side of the gateway's standard Modbus :502 mapping (change on conflict):
# MODBUS_502_HOST_PORT=502

# ======================
# InfluxDB — the stack bundles InfluxDB + Grafana. First boot self-configures
# with the values below; CHANGE the password/token, then enable the sink in
# the gateway UI (Config -> InfluxDB) and paste the same token.
# ======================
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me-before-first-start   # REQUIRED (3.81.0): no built-in default
DOCKER_INFLUXDB_INIT_ORG=multibus
DOCKER_INFLUXDB_INIT_BUCKET=multibus
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me-to-a-long-random-token   # REQUIRED (3.81.0)
# Gateway-side override (optional — usually set from the UI):
# INFLUXDB_ENABLED=true
# INFLUXDB_URL=http://influxdb:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=multibus
# INFLUXDB_BUCKET=multibus
# INFLUXDB_PUBLISH_MODE=changed

# ======================
# UI Configuration
# ======================
UI_PORT=8080

# ======================
# Security (optional)
# ======================
# If set, every state-changing API request (POST/PUT/PATCH/DELETE) must carry an
# X-API-Key header matching this value; the Web UI prompts for it once and
# remembers it. Read-only telemetry (GET) and the on-demand register queries
# stay open. Leave empty for an open, trusted-LAN appliance (default).
API_KEY=

# ======================
# Virtual Meters (optional)
# ======================
# Port range published for virtual Modbus meters (reachable on the LAN).
# Pick instance ports inside this range; widen the end if you need more.
# Port 502 (standard Modbus, e.g. Fronius DataManager) is published separately
# in docker-compose.yml. See docs/virtual-meter-spec.md.
VMETER_PORT_START=1502
VMETER_PORT_END=1512

# ======================
# Grafana (bundled)
# ======================
GF_SECURITY_ADMIN_PASSWORD=change-me-before-first-start   # REQUIRED (3.81.0): no built-in default

# ======================
# Device Builder (ESPHome) — all optional
# ======================
# Timezone for the bundled ESPHome container (and log timestamps).
TZ=Europe/Bucharest
# Where the gateway reaches the ESPHome dashboard. The bundled compose service
# is http://esphome:6052; on a fresh deploy this also SEEDS the feature on
# (a saved UI choice afterwards wins). Point elsewhere for an existing ESPHome.
ESPHOME_URL=http://esphome:6052
# Force the Builder on/off on every start regardless of the UI toggle. Leave
# unset to let the UI decide (recommended).
# ESPHOME_ENABLED=true
# If the ESPHome dashboard itself runs with a login, set it here — the same
# values configure BOTH the dashboard and the gateway's client to it.
ESPHOME_DASHBOARD_USERNAME=
ESPHOME_DASHBOARD_PASSWORD=

# --- Serial bridge (docker compose --profile rtu-bridge) ---------------------
# Where the gateway reaches the bridge's control API (default matches the
# bundled service name):
# SERIAL_BRIDGE_URL=http://mbg-serial-bridge:7000

# Which published image tag `docker compose pull` fetches (a version such as
# 3.79.0, a minor line such as 3.79, or latest). Ignored by `docker compose build`.
# MBG_VERSION=latest
# Adapters the bridge must NEVER expose (claimed by another service).
# Comma-separated; each token matches a stable id, /dev path, or USB port-path.
# BRIDGE_EXCLUDE=1a86:7523@1-1

# --- Shared-stack overlay (docker-compose.external-network.yml) ----------------------
# Name of the EXISTING external docker network to join (default below).
# PV_STACK_NETWORK=pv-stack-network
