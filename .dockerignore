# Build-context hygiene (audit 2026-08-14). Two jobs:
#  1. keep the context small/fast (.git 22M, node_modules 14M, tests, loadtest)
#  2. make `COPY config/ ./config/` structurally safe: a tree where the app has
#     RUN (config.yaml, passkeys, snapshots, audit log) must never bake that
#     runtime state — possibly live credentials — into a shippable image.
.git
.gitignore
.github
.audit
.claude
.pytest_cache
**/__pycache__
node_modules
tests
loadtest
serial-bridge
.env*
*.bak*
Dockerfile.test
docker-compose*.yml

# config/: the image ships ONLY the examples and the meter templates. Everything
# else under config/ is runtime state a tree the app has run in may hold
# (config.yaml, sessions, passkeys, snapshots, audit log, PQ state, the
# .good/.bad config copies) — an allow list cannot miss a new state file.
config/*
!config/config.example.yaml
!config/selected_registers.example.json
!config/templates/
# docs/ stays out of the context except the register catalogue the app loads
docs/*
!docs/modbus_data.json
